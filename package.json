    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
