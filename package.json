    "installer:build": "powershell -ExecutionPolicy Bypass -File scripts/build-unified-installer.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
