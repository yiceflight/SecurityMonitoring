{
  "name": "security-monitoring",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:client": "tauri dev",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
